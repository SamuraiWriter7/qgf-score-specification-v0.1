{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazene.org/schemas/qgf-score-v0.1.schema.json",
  "title": "QGF Score Specification v0.1",
  "description": "JSON Schema for QGF Score objects used to estimate the Question Gravitational Field of a question.",
  "type": "object",
  "required": ["qgf_score"],
  "additionalProperties": false,
  "properties": {
    "qgf_score": {
      "type": "object",
      "required": [
        "version",
        "question_id",
        "question_text",
        "language",
        "status",
        "formula",
        "parameters",
        "result",
        "limitations",
        "non_goals",
        "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "const": "0.1"
        },
        "question_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for the scored question."
        },
        "question_text": {
          "type": "string",
          "minLength": 1,
          "description": "The origin question or target question being evaluated."
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "description": "Language code or language label, such as en, ja, or multilingual."
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "sample",
            "resonant_sample",
            "experimental",
            "reviewed"
          ]
        },
        "formula": {
          "$ref": "#/$defs/formula"
        },
        "calibration": {
          "$ref": "#/$defs/calibration"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "interpretation": {
          "$ref": "#/$defs/interpretation"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "relationships": {
          "$ref": "#/$defs/relationships"
        },
        "field_class_reference": {
          "$ref": "#/$defs/field_class_reference"
        },
        "limitations": {
          "$ref": "#/$defs/string_list"
        },
        "non_goals": {
          "$ref": "#/$defs/string_list"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    }
  },
  "$defs": {
    "formula": {
      "type": "object",
      "description": "Formula strings used by the QGF Score object.",
      "additionalProperties": false,
      "properties": {
        "gravity_value": {
          "type": "string"
        },
        "raw_gravity_value": {
          "type": "string"
        },
        "calibrated_gravity_value": {
          "type": "string"
        },
        "qgf_score": {
          "type": "string"
        },
        "log_base": {
          "type": "string",
          "enum": ["natural", "base10", "custom"]
        },
        "calibration_note": {
          "type": "string"
        }
      },
      "required": ["qgf_score"],
      "anyOf": [
        {
          "required": ["gravity_value"]
        },
        {
          "required": ["raw_gravity_value"]
        },
        {
          "required": ["calibrated_gravity_value"]
        }
      ]
    },
    "calibration": {
      "type": "object",
      "description": "Optional calibration layer used to map normalized raw values into human-readable field classes.",
      "additionalProperties": false,
      "required": ["calibration_factor_K", "reason"],
      "properties": {
        "calibration_factor_K": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Core QGF parameters.",
      "additionalProperties": false,
      "required": [
        "S_source_strength",
        "D_depth",
        "I_influence",
        "C_coherence",
        "T_temporal_distance",
        "N_noise_level",
        "alpha_resonance_exponent",
        "beta_temporal_decay",
        "gamma_noise_sensitivity"
      ],
      "properties": {
        "S_source_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "D_depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "I_influence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "C_coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "T_temporal_distance": {
          "type": "number",
          "minimum": 1
        },
        "N_noise_level": {
          "type": "number",
          "minimum": 1
        },
        "alpha_resonance_exponent": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "beta_temporal_decay": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "gamma_noise_sensitivity": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      }
    },
    "result": {
      "type": "object",
      "description": "Computed or estimated QGF result.",
      "additionalProperties": false,
      "required": ["qgf_score", "field_class"],
      "properties": {
        "gravity_value": {
          "type": "number",
          "minimum": 0
        },
        "raw_gravity_value": {
          "type": "number",
          "minimum": 0
        },
        "calibrated_gravity_value": {
          "type": "number",
          "minimum": 0
        },
        "qgf_score": {
          "type": "number",
          "minimum": 0
        },
        "field_class": {
          "$ref": "#/$defs/field_class"
        }
      },
      "anyOf": [
        {
          "required": ["gravity_value"]
        },
        {
          "required": ["raw_gravity_value"]
        },
        {
          "required": ["calibrated_gravity_value"]
        }
      ]
    },
    "field_class": {
      "type": "string",
      "enum": [
        "Weak Field",
        "Local Field",
        "Structural Field",
        "Resonant Field",
        "Civilizational Field",
        "Gravity Well"
      ]
    },
    "interpretation": {
      "type": "object",
      "description": "Human-readable interpretation of the QGF result.",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "field_meaning": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Evidence references associated with the scored question.",
      "additionalProperties": false,
      "properties": {
        "trace_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "structure_fingerprints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "related_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output_item"
          }
        },
        "resonance_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "relationships": {
      "type": "object",
      "description": "Upstream, lateral, and downstream relationships.",
      "additionalProperties": false,
      "properties": {
        "upstream": {
          "$ref": "#/$defs/string_list"
        },
        "lateral": {
          "$ref": "#/$defs/string_list"
        },
        "downstream": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "field_class_reference": {
      "type": "object",
      "description": "Human-readable reference ranges for field classes.",
      "additionalProperties": false,
      "properties": {
        "weak_field": {
          "type": "string"
        },
        "local_field": {
          "type": "string"
        },
        "structural_field": {
          "type": "string"
        },
        "resonant_field": {
          "type": "string"
        },
        "civilizational_field": {
          "type": "string"
        },
        "gravity_well": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Metadata for the QGF object.",
      "additionalProperties": false,
      "required": ["created_by", "specification_version"],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "specification_version": {
          "type": "string",
          "const": "0.1"
        },
        "sample_type": {
          "type": "string"
        },
        "license_note": {
          "type": "string"
        }
      }
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
